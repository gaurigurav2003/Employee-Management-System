{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/employees/{**catch-all}"
        }
      },
      "department-route": {
        "ClusterId": "department-cluster",
        "Match": {
          "Path": "/api/v1/departments/{**catch-all}"
        }
      },
      "salary-route": {
        "ClusterId": "salary-cluster",
        "Match": {
          "Path": "/api/v1/salaries/{**catch-all}"
        }
      },
      "leave-route": {
        "ClusterId": "leave-cluster",
        "Match": {
          "Path": "/api/v1/leaves/{**catch-all}"
        }
      },
      "attendance-route": {
        "ClusterId": "attendance-cluster",
        "Match": {
          "Path": "/api/v1/attendance/{**catch-all}"
        }
      },
      "support-route": {
        "ClusterId": "support-cluster",
        "Match": {
          "Path": "/api/v1/support-tickets/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5088/"
          }
        }
      },
      "employee-cluster": {
        "Destinations": {
          "employee-service": {
            "Address": "http://localhost:5163/"
          }
        }
      },
      "department-cluster": {
        "Destinations": {
          "department-service": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "salary-cluster": {
        "Destinations": {
          "salary-service": {
            "Address": "http://localhost:5118/"
          }
        }
      },
      "leave-cluster": {
        "Destinations": {
          "leave-service": {
            "Address": "http://localhost:62417/"
          }
        }
      },
      "attendance-cluster": {
        "Destinations": {
          "attendance-service": {
            "Address": "http://localhost:64365/"
          }
        }
      },
      "support-cluster": {
        "Destinations": {
          "support-service": {
            "Address": "http://localhost:5133/"
          }
        }
      }
    }
  }
}
